# Delay between streamed tokens in the mock chat route, ms (0–1000). Default 35.
MOCK_TOKEN_DELAY_MS=35

# Delay of every write of the mock alerts route, ms (0–5000). Default 1200. Reads answer at once.
MOCK_ALERTS_DELAY_MS=1200

# Public site URL, used for absolute links and metadata. Optional.
NEXT_PUBLIC_SITE_URL=

# Sentry project key (public by design). Unset: Sentry is off (unit tests, CI lint). E2E sets a local fake one.
NEXT_PUBLIC_SENTRY_DSN=

# Sends to Sentry from this machine (next dev, a local build), as environment "local". Off unless true:
# a DSN alone sends nothing locally. Set it with the test page below; never on Vercel (it reports
# production or preview by itself, from NEXT_PUBLIC_VERCEL_ENV).
NEXT_PUBLIC_SENTRY_LOCAL=

# Opens /sentry-test and /api/v1/sentry-test. Off unless true; never set it on Vercel.
# Needs NEXT_PUBLIC_SENTRY_LOCAL=true too, or its events go nowhere.
ENABLE_SENTRY_TEST_PAGE=

# Build only: uploads source maps to Sentry. Unset: no upload (stack traces stay minified).
SENTRY_AUTH_TOKEN=
# Build only, with the token: the Sentry organisation and project slugs.
SENTRY_ORG=dmitriy-f
SENTRY_PROJECT=market-ops-console
